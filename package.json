{
  "name": "openai-responses-mcp",
  "version": "1.2.2",
  "description": "Lightweight MCP server (Responses API core). OpenAI integration + web_search.",
  "type": "module",
  "bin": {
    "openai-responses-mcp": "build/index.js"
  },
  "files": [
    "build",
    "config/config.yaml.example",
    "config/policy.md.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "npm run clean:build",
    "clean:build": "node scripts/clean.js",
    "deps:install": "npm ci",
    "deps:check": "node scripts/deps-check.js",
    "deps:update": "node scripts/deps-update.js",
    "build:clean": "npm run clean:build && npm run build",
    "build:fresh": "npm run clean:build && npm run deps:install && npm run build",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "mcp:stdio": "node build/index.js --stdio",
    "mcp:smoke": "node scripts/mcp-smoke.js",
    "mcp:smoke:ldjson": "node scripts/mcp-smoke-ldjson.js",
    "mcp:smoke:ping": "node scripts/mcp-smoke-ping.js",
    "mcp:quick": "node scripts/mcp-smoke-apikey.js",
    "mcp:answer": "node scripts/mcp-smoke-apikey.js --tool answer",
    "prepublishOnly": "npm run build:clean",
    "test": "npm run test:deps && npm run build:clean && node scripts/test-gpt56-support.js && node scripts/test-tools-list.js && node scripts/test-cancel-noinflight.js && node scripts/test-cancel-during-call.js",
    "test:deps": "node --test scripts/test-deps.js",
    "test:gpt56": "node scripts/test-gpt56-support.js",
    "test:tools-list": "node scripts/test-tools-list.js",
    "test:cancel-noinflight": "node scripts/test-cancel-noinflight.js",
    "test:cancel-during-call": "node scripts/test-cancel-during-call.js"
  },
  "dependencies": {
    "openai": "^7.10.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uchimanajet7/openai-responses-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/uchimanajet7/openai-responses-mcp/issues"
  },
  "homepage": "https://github.com/uchimanajet7/openai-responses-mcp#readme",
  "keywords": [
    "openai",
    "responses-api",
    "mcp",
    "model-context-protocol",
    "stdio",
    "mcp-server",
    "typescript",
    "cli",
    "web-search",
    "codex",
    "claude",
    "code"
  ],
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
